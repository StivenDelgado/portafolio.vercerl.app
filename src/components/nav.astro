---
const links = [
  { label: "Sobre mí", href: "#sobre-mi" },
  { label: "Lo que sé", href: "#lo-que-se" },
  { label: "Proyectos", href: "#proyectos" },
  { label: "Contacto", href: "#contacto" },
];
---

<header class="nav fixed inset-x-0 top-0 z-[100]">
  <div class="wrap flex items-center justify-between py-5">
    <a href="#inicio" class="mono text-[var(--fg)]" aria-label="Inicio">
      Stiven&nbsp;Delgado
    </a>

    <nav data-nav class="hidden md:block" aria-label="Principal">
      <ul class="flex gap-8">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="mono link text-[var(--muted)] hover:text-[var(--fg)] transition-colors">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="mono text-[var(--muted)] hidden sm:flex items-center gap-2">
      Armenia, CO <span data-clock>--:--</span>
    </p>

    <a href="#contacto" class="mono md:hidden text-[var(--fg)] link">Contacto</a>
  </div>
</header>

<style>
  .nav {
    mix-blend-mode: difference;
  }
  .nav :global(a.active) {
    color: var(--fg);
  }
</style>
