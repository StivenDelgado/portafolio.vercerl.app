---
const technologies = [
  { file: "astro", name: "Astro" },
  { file: "react", name: "React" },
  { file: "typeScript", name: "TypeScript" },
  { file: "javaScript", name: "JavaScript" },
  { file: "tailwindcss", name: "Tailwind" },
  { file: "nodejs", name: "Node.js" },
  { file: "springboot", name: "Spring Boot" },
  { file: "python", name: "Python" },
  { file: "mysql", name: "MySQL" },
  { file: "aws", name: "AWS" },
  { file: "azure", name: "Azure" },
  { file: "git", name: "Git" },
  { file: "bash", name: "Bash" },
];
---

<div class="border-t border-[var(--line)] py-8 overflow-hidden mask" aria-label="Tecnologías">
  <div class="marquee">
    {
      [0, 1].map((copy) => (
        <ul class="flex shrink-0 items-center gap-14 pr-14" aria-hidden={copy === 1 ? "true" : undefined}>
          {technologies.map((t) => (
            <li class="flex items-center gap-3 text-[var(--muted)] hover:text-[var(--fg)] transition-colors">
              <img src={`/svg/${t.file}.svg`} alt="" width="22" height="22" loading="lazy" class="h-[22px] w-auto grayscale opacity-70" />
              <span class="text-2xl md:text-3xl tracking-tight">{t.name}</span>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .mask {
    mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
  }
</style>
