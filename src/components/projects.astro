---
import { Image, getImage } from "astro:assets";
import mixzer from "@/assets/projects/mixzer.webp";
import axm from "@/assets/projects/axm-studio.jpg";

interface Project {
  title: string;
  url: string;
  role: string;
  desc: string;
  image: ImageMetadata;
  // Optional looping video shown instead of the still image.
  video?: string;
}

const projects: Project[] = [
  {
    title: "Mixzer",
    url: "https://mixzer.co/",
    role: "Plataforma para artistas",
    desc: "SmartLinks, estadísticas y regalías",
    image: mixzer,
  },
  {
    title: "AXM Studio",
    url: "https://axm-studio.vercel.app/",
    role: "Experiencia audiovisual",
    desc: "Sitio inmersivo con video y tienda",
    image: axm,
    video: "/videos/axm-studio.mp4",
  },
];

const posters = await Promise.all(
  projects.map((p) => getImage({ src: p.image, width: 960, format: "webp" })),
);
---

<section id="proyectos" class="section">
  <div class="wrap">
    <div class="grid md:grid-cols-12 gap-10 mb-16 md:mb-24">
      <p class="mono label md:col-span-3" data-reveal>Proyectos</p>
      <h2 class="md:col-span-9 text-5xl md:text-7xl lg:text-8xl font-medium tracking-[-0.04em] leading-[0.95]" data-split>
        Trabajo seleccionado
      </h2>
    </div>

    <ul class="border-b border-[var(--line)]">
      {
        projects.map((p, i) => (
          <li class="border-t border-[var(--line)]" data-reveal style={`--d: ${i * 100}ms`}>
            <div class="project group relative grid md:grid-cols-12 gap-4 md:gap-10 py-8 md:py-12 items-center" data-project={i}>
              <span class="mono text-[var(--muted)] md:col-span-3">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="md:col-span-5 text-5xl md:text-7xl tracking-[-0.04em] transition-[transform,color] duration-700 ease-[cubic-bezier(.22,1,.36,1)] group-hover:translate-x-4">
                <a href={p.url} target="_blank" rel="noopener noreferrer" class="stretched">
                  {p.title}
                </a>
              </h3>
              <div class="md:col-span-3 flex flex-col gap-2 text-[var(--muted)]">
                <span>{p.role}</span>
                <span class="mono">{p.desc}</span>
                <a href={p.url} target="_blank" rel="noopener noreferrer" class="mono link relative z-10 self-start text-[var(--fg)] mt-1">
                  Visitar sitio ↗
                </a>
              </div>
              <span class="hidden md:flex md:col-span-1 justify-end text-3xl transition-transform duration-700 ease-[cubic-bezier(.22,1,.36,1)] group-hover:-rotate-45" aria-hidden="true">
                →
              </span>
              <div class="md:hidden col-span-full mt-2 rounded-xl overflow-hidden aspect-[16/9]">
                {p.video ? (
                  <video
                    src={p.video}
                    poster={posters[i].src}
                    class="w-full h-full object-cover"
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="none"
                    aria-label={`Video de ${p.title}`}
                  />
                ) : (
                  <Image src={p.image} alt={`Captura de ${p.title}`} width={900} class="w-full h-full object-cover" />
                )}
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="preview" data-preview aria-hidden="true">
    {
      projects.map((p, i) =>
        p.video ? (
          <video src={p.video} poster={posters[i].src} data-preview-img={i} muted loop playsinline preload="none" />
        ) : (
          <img src={posters[i].src} alt="" data-preview-img={i} loading="lazy" decoding="async" />
        ),
      )
    }
  </div>
</section>

<style>
  .project:hover h3 {
    color: var(--accent);
  }
  .stretched::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  @media (pointer: fine) {
    #proyectos ul:hover .project:not(:hover) {
      opacity: 0.35;
    }
    .project {
      transition: opacity 0.5s var(--ease);
    }
  }

  .preview {
    display: none;
  }
  @media (pointer: fine) and (min-width: 768px) {
    .preview {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      width: 420px;
      aspect-ratio: 16 / 9;
      border-radius: 14px;
      overflow: hidden;
      pointer-events: none;
      z-index: 50;
      clip-path: inset(50% 50% 50% 50% round 14px);
      transition: clip-path 0.6s var(--ease);
    }
    .preview:global(.on) {
      clip-path: inset(0 0 0 0 round 14px);
    }
    .preview img,
    .preview video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      transform: scale(1.15);
      transition:
        opacity 0.4s var(--ease),
        transform 0.8s var(--ease);
    }
    .preview img:global(.on),
    .preview video:global(.on) {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>
