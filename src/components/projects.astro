---
import { Image, getImage } from "astro:assets";
import stockin from "@/assets/projects/stockin.png";
import svgl from "@/assets/projects/svgl.png";

interface Project {
  title: string;
  preview: string;
  role: string;
  status: string;
  image?: ImageMetadata;
  repo?: string;
  // Cover colors used when there is no screenshot.
  cover?: [string, string];
}

const projects: Project[] = [
  {
    title: "Mixzer",
    preview: "https://mixzer.co/",
    role: "Sitio web",
    status: "En línea",
    cover: ["#a476ff", "#1b1030"],
  },
  {
    title: "AXM Studio",
    preview: "https://axm-studio.vercel.app/",
    role: "Sitio web",
    status: "En línea",
    cover: ["#ececec", "#3a3a3a"],
  },
  {
    title: "StockIn",
    image: stockin,
    repo: "https://github.com/gothsec/stockin-demo",
    preview: "https://stockin-demo.vercel.app",
    role: "Proyecto propio",
    status: "En desarrollo",
  },
  {
    title: "Svgl.app",
    image: svgl,
    repo: "https://github.com/pheralb/svgl",
    preview: "https://svgl.app",
    role: "Open source",
    status: "Contribuidor",
  },
];

const previews = await Promise.all(
  projects.map((p) => (p.image ? getImage({ src: p.image, width: 720, format: "webp" }) : null)),
);
const domain = (url: string) => new URL(url).hostname.replace(/^www\./, "");
---

<section id="proyectos" class="section">
  <div class="wrap">
    <div class="grid md:grid-cols-12 gap-10 mb-16 md:mb-24">
      <p class="mono label md:col-span-3" data-reveal>Proyectos</p>
      <h2 class="md:col-span-9 text-5xl md:text-7xl lg:text-8xl font-medium tracking-[-0.04em] leading-[0.95]" data-split>
        Trabajo seleccionado
      </h2>
    </div>

    <ul class="border-b border-[var(--line)]">
      {
        projects.map((p, i) => (
          <li class="border-t border-[var(--line)]" data-reveal style={`--d: ${i * 100}ms`}>
            <div class="project group relative grid md:grid-cols-12 gap-4 md:gap-10 py-8 md:py-12 items-center" data-project={i}>
              <span class="mono text-[var(--muted)] md:col-span-3">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="md:col-span-5 text-5xl md:text-7xl tracking-[-0.04em] transition-[transform,color] duration-700 ease-[cubic-bezier(.22,1,.36,1)] group-hover:translate-x-4">
                <a href={p.preview} target="_blank" rel="noopener noreferrer" class="stretched">
                  {p.title}
                </a>
              </h3>
              <div class="md:col-span-3 flex flex-wrap md:flex-col gap-x-4 gap-y-2 text-[var(--muted)]">
                <span>{p.role} · <span class="mono">{p.status}</span></span>
                <span class="flex gap-4">
                  <a href={p.preview} target="_blank" rel="noopener noreferrer" class="mono link relative z-10 text-[var(--fg)]">
                    Visitar sitio ↗
                  </a>
                  {p.repo && (
                    <a href={p.repo} target="_blank" rel="noopener noreferrer" class="mono link relative z-10 hover:text-[var(--fg)]">
                      Código ↗
                    </a>
                  )}
                </span>
              </div>
              <span class="hidden md:flex md:col-span-1 justify-end text-3xl transition-transform duration-700 ease-[cubic-bezier(.22,1,.36,1)] group-hover:-rotate-45" aria-hidden="true">
                →
              </span>
              {p.image ? (
                <Image
                  src={p.image}
                  alt={`Captura de ${p.title}`}
                  width={900}
                  class="md:hidden col-span-full w-full rounded-xl mt-2 aspect-[16/10] object-cover"
                />
              ) : (
                <div class="cover md:hidden col-span-full rounded-xl mt-2 aspect-[16/10]" style={`--c1: ${p.cover?.[0]}; --c2: ${p.cover?.[1]}`}>
                  <span class="cover-title">{p.title}</span>
                  <span class="mono cover-url">{domain(p.preview)}</span>
                </div>
              )}
            </div>
          </li>
        ))
      }
    </ul>

    <div class="mt-12" data-reveal>
      <a
        href="https://github.com/StivenDelgado?tab=repositories"
        target="_blank"
        rel="noopener noreferrer"
        class="btn"
        data-magnetic="0.25"
      >
        Más proyectos en GitHub ↗
      </a>
    </div>
  </div>

  <div class="preview" data-preview aria-hidden="true">
    {
      previews.map((img, i) =>
        img ? (
          <img src={img.src} alt="" data-preview-img={i} loading="lazy" decoding="async" />
        ) : (
          <div class="cover" data-preview-img={i} style={`--c1: ${projects[i].cover?.[0]}; --c2: ${projects[i].cover?.[1]}`}>
            <span class="cover-title">{projects[i].title}</span>
            <span class="mono cover-url">{domain(projects[i].preview)}</span>
          </div>
        ),
      )
    }
  </div>
</section>

<style>
  .project:hover h3 {
    color: var(--accent);
  }
  .stretched::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  @media (pointer: fine) {
    #proyectos ul:hover .project:not(:hover) {
      opacity: 0.35;
    }
    .project {
      transition: opacity 0.5s var(--ease);
    }
  }

  .cover {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.25rem;
    overflow: hidden;
    color: var(--bg);
    background:
      radial-gradient(120% 90% at 100% 0%, var(--c1), transparent 60%),
      linear-gradient(160deg, var(--c2), #0c0c0c);
  }
  @media (min-width: 768px) {
    .project .cover {
      display: none;
    }
  }
  .cover-title {
    align-self: flex-end;
    font-size: 2.6rem;
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--fg);
    order: 2;
  }
  .cover-url {
    color: var(--fg);
    opacity: 0.7;
    order: 1;
  }

  .preview {
    display: none;
  }
  @media (pointer: fine) and (min-width: 768px) {
    .preview {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      width: 360px;
      aspect-ratio: 16 / 10;
      border-radius: 14px;
      overflow: hidden;
      pointer-events: none;
      z-index: 50;
    }
    .preview img,
    .preview .cover {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      transform: scale(1.15);
      transition:
        opacity 0.4s var(--ease),
        transform 0.8s var(--ease);
    }
    .preview img:global(.on),
    .preview .cover:global(.on) {
      opacity: 1;
      transform: scale(1);
    }
    .preview {
      clip-path: inset(50% 50% 50% 50% round 14px);
      transition: clip-path 0.6s var(--ease);
    }
    .preview:global(.on) {
      clip-path: inset(0 0 0 0 round 14px);
    }
  }
</style>
