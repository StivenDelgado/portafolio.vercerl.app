---
import { Image, getImage } from "astro:assets";
import stockin from "@/assets/projects/stockin.png";
import svgl from "@/assets/projects/svgl.png";

const projects = [
  {
    title: "StockIn",
    image: stockin,
    repo: "https://github.com/gothsec/stockin-demo",
    preview: "https://stockin-demo.vercel.app",
    role: "Proyecto propio",
    status: "En desarrollo",
  },
  {
    title: "Svgl.app",
    image: svgl,
    repo: "https://github.com/pheralb/svgl",
    preview: "https://svgl.app",
    role: "Open source",
    status: "Contribuidor",
  },
];

const previews = await Promise.all(
  projects.map((p) => getImage({ src: p.image, width: 720, format: "webp" })),
);
---

<section id="proyectos" class="section">
  <div class="wrap">
    <div class="grid md:grid-cols-12 gap-10 mb-16 md:mb-24">
      <p class="mono label md:col-span-3" data-reveal>Proyectos</p>
      <h2 class="md:col-span-9 text-5xl md:text-7xl lg:text-8xl font-medium tracking-[-0.04em] leading-[0.95]" data-split>
        Trabajo seleccionado
      </h2>
    </div>

    <ul class="border-b border-[var(--line)]">
      {
        projects.map((p, i) => (
          <li class="border-t border-[var(--line)]" data-reveal style={`--d: ${i * 100}ms`}>
            <div class="project group relative grid md:grid-cols-12 gap-4 md:gap-10 py-8 md:py-12 items-center" data-project={i}>
              <span class="mono text-[var(--muted)] md:col-span-3">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="md:col-span-5 text-5xl md:text-7xl tracking-[-0.04em] transition-[transform,color] duration-700 ease-[cubic-bezier(.22,1,.36,1)] group-hover:translate-x-4">
                <a href={p.preview} target="_blank" rel="noopener noreferrer" class="stretched">
                  {p.title}
                </a>
              </h3>
              <div class="md:col-span-3 flex flex-wrap md:flex-col gap-x-4 gap-y-2 text-[var(--muted)]">
                <span>{p.role} · <span class="mono">{p.status}</span></span>
                <a href={p.repo} target="_blank" rel="noopener noreferrer" class="mono link relative z-10 self-start hover:text-[var(--fg)]">
                  Código ↗
                </a>
              </div>
              <span class="hidden md:flex md:col-span-1 justify-end text-3xl transition-transform duration-700 ease-[cubic-bezier(.22,1,.36,1)] group-hover:-rotate-45" aria-hidden="true">
                →
              </span>
              <Image
                src={p.image}
                alt={`Captura de ${p.title}`}
                width={900}
                class="md:hidden col-span-full w-full rounded-xl mt-2 aspect-[16/10] object-cover"
              />
            </div>
          </li>
        ))
      }
    </ul>

    <div class="mt-12" data-reveal>
      <a
        href="https://github.com/StivenDelgado?tab=repositories"
        target="_blank"
        rel="noopener noreferrer"
        class="btn"
        data-magnetic="0.25"
      >
        Más proyectos en GitHub ↗
      </a>
    </div>
  </div>

  <div class="preview" data-preview aria-hidden="true">
    {previews.map((img, i) => <img src={img.src} alt="" data-preview-img={i} loading="lazy" decoding="async" />)}
  </div>
</section>

<style>
  .project:hover h3 {
    color: var(--accent);
  }
  .stretched::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  @media (pointer: fine) {
    #proyectos ul:hover .project:not(:hover) {
      opacity: 0.35;
    }
    .project {
      transition: opacity 0.5s var(--ease);
    }
  }

  .preview {
    display: none;
  }
  @media (pointer: fine) and (min-width: 768px) {
    .preview {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      width: 360px;
      aspect-ratio: 16 / 10;
      border-radius: 14px;
      overflow: hidden;
      pointer-events: none;
      z-index: 50;
    }
    .preview img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      transform: scale(1.15);
      transition:
        opacity 0.4s var(--ease),
        transform 0.8s var(--ease);
    }
    .preview :global(img.on) {
      opacity: 1;
      transform: scale(1);
    }
    .preview {
      clip-path: inset(50% 50% 50% 50% round 14px);
      transition: clip-path 0.6s var(--ease);
    }
    .preview:global(.on) {
      clip-path: inset(0 0 0 0 round 14px);
    }
  }
</style>
