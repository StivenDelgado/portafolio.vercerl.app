---
const principles = [
  { n: "01", t: "Código claro", d: "Soluciones simples, legibles y fáciles de mantener." },
  { n: "02", t: "De punta a punta", d: "De la interfaz a la base de datos, la API y la nube." },
  { n: "03", t: "Rendimiento", d: "Sitios rápidos y ligeros que se sienten bien al usarlos." },
];
---

<section id="sobre-mi" class="section">
  <div class="wrap grid md:grid-cols-12 gap-10">
    <p class="mono label md:col-span-3 self-start" data-reveal>Sobre mí</p>

    <div class="md:col-span-9">
      <p class="text-3xl md:text-5xl lg:text-6xl leading-[1.1] tracking-[-0.03em]" data-words>
        Soy desarrollador full‑stack en Armenia, Colombia. Convierto ideas en productos digitales
        completos: desde la interfaz que ve el usuario hasta la API, la base de datos y el despliegue.
        Me gusta el diseño simple, el código limpio y las cosas que funcionan rápido.
      </p>

      <div class="mt-20 grid sm:grid-cols-3 gap-10">
        {
          principles.map((p, i) => (
            <div data-reveal style={`--d: ${i * 120}ms`}>
              <span class="block h-px bg-[var(--line)] mb-6" data-line style={`--d: ${i * 120}ms`} />
              <p class="mono text-[var(--muted)] mb-3">{p.n}</p>
              <h3 class="text-xl mb-2">{p.t}</h3>
              <p class="text-[var(--muted)] leading-relaxed">{p.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
