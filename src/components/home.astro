---
const roles = ["productos web", "APIs", "interfaces", "despliegues"];
const year = new Date().getFullYear();
---

<section id="inicio" class="relative min-h-[100svh] flex flex-col justify-end pb-10 pt-32 overflow-hidden">
  <div class="glow" data-parallax="0.25" aria-hidden="true"></div>

  <div class="wrap w-full relative">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-8 md:mb-12">
      <p class="mono label" data-reveal>Portafolio — {year}</p>
      <p class="mono text-[var(--muted)] flex items-center gap-3" data-reveal style="--d: 150ms">
        <span class="pulse"></span> Disponible para proyectos
      </p>
    </div>

    <h1 class="hero-title font-medium tracking-[-0.05em] leading-[0.9]">
      <span class="block" data-split>Stiven</span>
      <span class="block md:pl-[12vw]" data-split style="--d: 200ms">Delgado</span>
    </h1>

    <div class="mt-10 md:mt-14 grid md:grid-cols-12 gap-8 items-end">
      <p class="md:col-span-7 lg:col-span-6 text-xl md:text-2xl leading-snug text-[var(--muted)]" data-reveal style="--d: 600ms">
        Desarrollador de software <span class="text-[var(--fg)]">full‑stack</span>. Construyo
        <span class="rotator" data-rotate>
          {roles.map((r) => <span>{r}</span>)}
        </span>
        de principio a fin, con código limpio y pensado para escalar.
      </p>

      <div class="md:col-span-5 lg:col-span-6 flex md:justify-end gap-3" data-reveal style="--d: 750ms">
        <a href="#proyectos" class="btn btn-solid" data-magnetic="0.25">Ver proyectos</a>
        <a href="#contacto" class="btn" data-magnetic="0.25">Hablemos</a>
      </div>
    </div>

    <div class="mt-16 flex items-center gap-4 text-[var(--muted)]" data-reveal style="--d: 900ms">
      <span class="mono">Scroll</span>
      <span class="scroll-line"></span>
    </div>
  </div>
</section>

<style>
  .hero-title {
    font-size: clamp(4.5rem, 21vw, 19rem);
  }
  .glow {
    position: absolute;
    width: 60vmax;
    height: 60vmax;
    top: -25vmax;
    right: -20vmax;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(164, 118, 255, 0.22), transparent 60%);
    filter: blur(20px);
    pointer-events: none;
  }
  .scroll-line {
    position: relative;
    width: 5rem;
    height: 1px;
    background: var(--line);
    overflow: hidden;
  }
  .scroll-line::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--fg);
    animation: scan 2.2s var(--ease) infinite;
  }
  @keyframes scan {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(100%);
    }
  }
  :global(.btn) {
    display: inline-flex;
    align-items: center;
    padding: 0.9rem 1.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.95rem;
    transition:
      background-color 0.4s var(--ease),
      color 0.4s var(--ease),
      border-color 0.4s var(--ease);
  }
  :global(.btn:hover) {
    border-color: var(--fg);
  }
  :global(.btn-solid) {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }
  :global(.btn-solid:hover) {
    background: var(--accent);
    border-color: var(--accent);
  }
</style>
